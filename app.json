{
  "expo": {
    "name": "LinguaAdapt",
    "slug": "linguaadapt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bardamri.linguaadapt",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bardamri.linguaadapt"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "baseUrl": "/LinguaAdapt"
    },
    "experiments": {
      "baseUrl": "/LinguaAdapt"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ceca9f2f-f1bb-44b4-a047-d35b4f6ccc7b"
      }
    },
    "owner": "bardamris-organization"
  }
}
