"he": "חם היום",
"heNiqqud": "חַם הַיּוֹם",
"translit": "kham hayom",
"en": "It's hot today"
},
{
"id": "p:small-talk:3",
"situation": "small talk",
"he": "קר בחוץ",
"heNiqqud": "קַר בַּחוּץ",
"translit": "kar bakhuts",
"en": "It's cold outside"
},
{
"id": "p:small-talk:4",
"situation": "small talk",
"he": "יורד גשם",
"heNiqqud": "יוֹרֵד גֶּשֶׁם",
"translit": "yored geshem",
"en": "It's raining"
},
{
"id": "p:small-talk:5",
"situation": "small talk",
"he": "מה אתה עושה בסוף השבוע?",
"heNiqqud": "מָה אַתָּה עוֹשֶׂה בְּסוֹף הַשָּׁבוּעַ?",
"translit": "ma ata ose besof hashavua?",
"en": "What are you doing this weekend?",
"noteEn": "To a woman: ma at osa…"
},
{
"id": "p:small-talk:6",
"situation": "small talk",
"he": "אני אוהב את ישראל",
"heNiqqud": "אֲנִי אוֹהֵב אֶת יִשְׂרָאֵל",
"translit": "ani ohev et yisrael",
"en": "I love Israel",
"noteEn": "A woman says: ani ohevet"
},
{
"id": "p:small-talk:7",
"situation": "small talk",
"he": "מה הטלפון שלך?",
"heNiqqud": "מָה הַטֵּלֵפוֹן שֶׁלְּךָ?",
"translit": "ma hatelefon shelkha?",
"en": "What's your phone number?",
"noteEn": "To a woman: shelakh"
},
{
"id": "p:small-talk:8",
"situation": "small talk",
"he": "בוא נלך",
"heNiqqud": "בּוֹא נֵלֵךְ",
"translit": "bo nelekh",
"en": "Let's go",
"noteEn": "To a woman: bo'i nelekh"
},
{
"id": "p:small-talk:9",
"situation": "small talk",
"he": "יאללה",
"heNiqqud": "יַאלְלָה",
"translit": "yalla",
"en": "Come on / Let's go",
"noteEn": "Very common Israeli slang (from Arabic)."
},
{
"id": "p:small-talk:10",
"situation": "small talk",
"he": "סבבה",
"heNiqqud": "סַבֶּבָּה",
"translit": "sababa",
"en": "Cool / Great",
"noteEn": "Slang."
},
{
"id": "p:small-talk:11",
"situation": "small talk",
"he": "אחלה",
"heNiqqud": "אַחְלָה",
"translit": "akhla",
"en": "Awesome",
"noteEn": "Slang."
},
{
"id": "p:small-talk:12",
"situation": "small talk",
"he": "באמת?",
"heNiqqud": "בֶּאֱמֶת?",
"translit": "be'emet?",
"en": "Really?"
},
{
"id": "p:small-talk:13",
"situation": "small talk",
"he": "אין מצב!",
"heNiqqud": "אֵין מַצָּב!",
"translit": "ein matsav!",
"en": "No way!",
"noteEn": "Slang."
},
{
"id": "p:small-talk:14",
"situation": "small talk",
"he": "כל הכבוד",
"heNiqqud": "כׇּל הַכָּבוֹד",
"translit": "kol hakavod",
"en": "Well done"
},
{
"id": "p:feelings:1",
"situation": "feelings",
"he": "אני שמח",
"heNiqqud": "אֲנִי שָׂמֵחַ",
"translit": "ani sameach",
"en": "I'm happy",
"noteEn": "A woman says: ani smekha",
"noteHe": "אישה אומרת: אני שמחה"
},
{
"id": "p:feelings:2",
"situation": "feelings",
"he": "אני עייף",
"heNiqqud": "אֲנִי עָיֵיף",
"translit": "ani ayef",
"en": "I'm tired",
"noteEn": "A woman says: ani ayefa",
"noteHe": "אישה אומרת: אני עייפה"
},
{
"id": "p:feelings:3",
"situation": "feelings",
"he": "אני עצוב",
"heNiqqud": "אֲנִי עָצוּב",
"translit": "ani atsuv",
"en": "I'm sad",
"noteEn": "A woman says: ani atsuva"
},
{
"id": "p:feelings:4",
"situation": "feelings",
"he": "אני לחוץ",
"heNiqqud": "אֲנִי לָחוּץ",
"translit": "ani lakhuts",
"en": "I'm stressed",
"noteEn": "A woman says: ani lakhutsa"
},
{
"id": "p:feelings:5",
"situation": "feelings",
"he": "אני מתגעגע אליך",
"heNiqqud": "אֲנִי מִתְגַּעְגֵּעַ אֵלֶיךָ",
"translit": "ani mitga'agea elekha",
"en": "I miss you",
"noteEn": "A woman says: ani mitga'aga'at"
},
{
"id": "p:feelings:6",
"situation": "feelings",
"he": "אני אוהב אותך",
"heNiqqud": "אֲנִי אוֹהֵב אוֹתְךָ",
"translit": "ani ohev otakh",
"en": "I love you",
"noteEn": "Man to a woman. Woman to a man: ani ohevet otkha"
},
{
"id": "p:feelings:7",
"situation": "feelings",
"he": "לא נורא",
"heNiqqud": "לֹא נוֹרָא",
"translit": "lo nora",
"en": "Never mind / It's not so bad"
},
{
"id": "p:feelings:8",
"situation": "feelings",
"he": "אל תדאג",
"heNiqqud": "אַל תִּדְאַג",
"translit": "al tid'ag",
"en": "Don't worry",
"noteEn": "To a woman: al tid'agi"
},
{
"id": "p:home:1",
"situation": "home",
"he": "תיכנס, בבקשה",
"heNiqqud": "תִּיכָּנֵס, בְּבַקָּשָׁה",
"translit": "tikanes, bevakasha",
"en": "Come in, please",
"noteEn": "To a woman: tikansi"
},
{
"id": "p:home:2",
"situation": "home",
"he": "תרגיש בבית",
"heNiqqud": "תַּרְגִּישׁ בַּבַּיִת",
"translit": "targish babayit",
"en": "Make yourself at home",
"noteEn": "To a woman: targishi"
},
{
"id": "p:home:3",
"situation": "home",
"he": "אתה רוצה משהו לשתות?",
"heNiqqud": "אַתָּה רוֹצֶה מַשֶּׁהוּ לִשְׁתּוֹת?",
"translit": "ata rotse mashehu lishtot?",
"en": "Would you like something to drink?",
"noteEn": "To a woman: at rotsa…"
},
{
"id": "p:home:4",
"situation": "home",
"he": "הארוחה מוכנה",
"heNiqqud": "הָאֲרוּחָה מוּכָנָה",
"translit": "ha'arukha mukhana",
"en": "Dinner is ready"
},
{
"id": "p:home:5",
"situation": "home",
"he": "לילה טוב, חלומות פז",
"heNiqqud": "לַיְלָה טוֹב, חֲלוֹמוֹת פָּז",
"translit": "laila tov, khalomot paz",
"en": "Good night, sweet dreams",
"noteEn": "Literally \"golden dreams\"."
},
{
"id": "p:work:1",
"situation": "work",
"he": "יש לי פגישה",
"heNiqqud": "יֵשׁ לִי פְּגִישָׁה",
"translit": "yesh li pgisha",
"en": "I have a meeting"
},
{
"id": "p:work:2",
"situation": "work",
"he": "אני בעבודה",
"heNiqqud": "אֲנִי בָּעֲבוֹדָה",
"translit": "ani ba'avoda",
"en": "I'm at work"
},
{
"id": "p:work:3",
"situation": "work",
"he": "מתי אתה מסיים?",
"heNiqqud": "מָתַי אַתָּה מְסַיֵּים?",
"translit": "matai ata mesayem?",
"en": "When do you finish?",
"noteEn": "To a woman: at mesayemet"
},
{
"id": "p:work:4",
"situation": "work",
"he": "אני מאחר",
"heNiqqud": "אֲנִי מְאַחֵר",
"translit": "ani me'akher",
"en": "I'm running late",
"noteEn": "A woman says: ani me'akheret"
},
{
"id": "p:work:5",
"situation": "work",
"he": "נדבר מחר",
"heNiqqud": "נְדַבֵּר מָחָר",
"translit": "nedaber makhar",
"en": "We'll talk tomorrow"
}
]
}