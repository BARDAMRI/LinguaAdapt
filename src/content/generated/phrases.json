{
"id": "p:greetings:1",
"situation": "greetings",
"he": "שלום",
"heNiqqud": "שָׁלוֹם",
"translit": "shalom",
"en": "Hello",
"noteEn": "Also means \"goodbye\" and \"peace\"."
},
{
"id": "p:greetings:2",
"situation": "greetings",
"he": "היי",
"heNiqqud": "הַיי",
"translit": "hai",
"en": "Hi"
},
{
"id": "p:greetings:3",
"situation": "greetings",
"he": "בוקר טוב",
"heNiqqud": "בּוֹקֶר טוֹב",
"translit": "boker tov",
"en": "Good morning",
"noteEn": "Answer: בוקר אור (boker or) — \"morning of light\"."
},
{
"id": "p:greetings:4",
"situation": "greetings",
"he": "צהריים טובים",
"heNiqqud": "צׇהֳרַיִים טוֹבִים",
"translit": "tsohorayim tovim",
"en": "Good afternoon"
},
{
"id": "p:greetings:5",
"situation": "greetings",
"he": "ערב טוב",
"heNiqqud": "עֶרֶב טוֹב",
"translit": "erev tov",
"en": "Good evening"
},
{
"id": "p:greetings:6",
"situation": "greetings",
"he": "לילה טוב",
"heNiqqud": "לַיְלָה טוֹב",
"translit": "laila tov",
"en": "Good night"
},
{
"id": "p:greetings:7",
"situation": "greetings",
"he": "מה שלומך?",
"heNiqqud": "מָה שְׁלוֹמְךָ?",
"translit": "ma shlomkha?",
"en": "How are you?",
"noteEn": "To a woman: ma shlomekh? (same spelling)",
"noteHe": "לאישה: מה שלומֵךְ"
},
{
"id": "p:greetings:8",
"situation": "greetings",
"he": "מה נשמע?",
"heNiqqud": "מָה נִשְׁמָע?",
"translit": "ma nishma?",
"en": "What's up?",
"noteEn": "Literally \"what is heard?\""
},
{
"id": "p:greetings:9",
"situation": "greetings",
"he": "מה קורה?",
"heNiqqud": "מָה קוֹרֶה?",
"translit": "ma kore?",
"en": "What's happening?"
},
{
"id": "p:greetings:10",
"situation": "greetings",
"he": "הכול בסדר",
"heNiqqud": "הַכּוֹל בְּסֵדֶר",
"translit": "hakol beseder",
"en": "Everything is fine"
},
{
"id": "p:greetings:11",
"situation": "greetings",
"he": "טוב, תודה",
"heNiqqud": "טוֹב, תּוֹדָה",
"translit": "tov, toda",
"en": "Good, thanks"
},
{
"id": "p:greetings:12",
"situation": "greetings",
"he": "ככה ככה",
"heNiqqud": "כָּכָה כָּכָה",
"translit": "kakha kakha",
"en": "So-so"
},
{
"id": "p:greetings:13",
"situation": "greetings",
"he": "להתראות",
"heNiqqud": "לְהִתְרָאוֹת",
"translit": "lehitraot",
"en": "See you / Goodbye"
},
{
"id": "p:greetings:14",
"situation": "greetings",
"he": "ביי",
"heNiqqud": "בַּיי",
"translit": "bai",
"en": "Bye"
},
{
"id": "p:greetings:15",
"situation": "greetings",
"he": "נתראה מחר",
"heNiqqud": "נִתְרָאֶה מָחָר",
"translit": "nitrae makhar",
"en": "See you tomorrow"
},
{
"id": "p:greetings:16",
"situation": "greetings",
"he": "שבת שלום",
"heNiqqud": "שַׁבַּת שָׁלוֹם",
"translit": "shabat shalom",
"en": "Have a peaceful Shabbat",
"noteEn": "Said from Friday afternoon until Saturday night."
},
{
"id": "p:greetings:17",
"situation": "greetings",
"he": "שבוע טוב",
"heNiqqud": "שָׁבוּעַ טוֹב",
"translit": "shavua tov",
"en": "Have a good week",
"noteEn": "Said on Saturday night and Sunday."
},
{
"id": "p:greetings:18",
"situation": "greetings",
"he": "חג שמח",
"heNiqqud": "חַג שָׂמֵחַ",
"translit": "khag sameach",
"en": "Happy holiday"
},
{
"id": "p:greetings:19",
"situation": "greetings",
"he": "ברוך הבא",
"heNiqqud": "בָּרוּךְ הַבָּא",
"translit": "barukh haba",
"en": "Welcome",
"noteEn": "To a woman: brukha haba'a",
"noteHe": "לאישה: ברוכה הבאה"
},
{
"id": "p:introductions:1",
"situation": "introductions",
"he": "איך קוראים לך?",
"heNiqqud": "אֵיךְ קוֹרְאִים לְךָ?",
"translit": "eikh korim lekha?",
"en": "What's your name?",
"noteEn": "To a woman: eikh korim lakh?"
},
{
"id": "p:introductions:2",
"situation": "introductions",
"he": "קוראים לי דני",
"heNiqqud": "קוֹרְאִים לִי דָּנִי",
"translit": "korim li dani",
"en": "My name is Danny",
"noteEn": "Literally \"they call me Danny\"."
},
{
"id": "p:introductions:3",
"situation": "introductions",
"he": "נעים מאוד",
"heNiqqud": "נָעִים מְאוֹד",
"translit": "na'im me'od",
"en": "Nice to meet you"
},
{
"id": "p:introductions:4",
"situation": "introductions",
"he": "מאיפה אתה?",
"heNiqqud": "מֵאֵיפֹה אַתָּה?",
"translit": "me'eifo ata?",
"en": "Where are you from?",
"noteEn": "To a woman: me'eifo at?",
"noteHe": "לאישה: מאיפה את?"
},
{
"id": "p:introductions:5",
"situation": "introductions",
"he": "אני מאנגליה",
"heNiqqud": "אֲנִי מֵאַנְגְּלִיָּה",
"translit": "ani me'anglia",
"en": "I'm from England"
},
{
"id": "p:introductions:6",
"situation": "introductions",
"he": "אני גר בתל אביב",
"heNiqqud": "אֲנִי גָּר בְּתֵל אָבִיב",
"translit": "ani gar betel aviv",
"en": "I live in Tel Aviv",
"noteEn": "A woman says: ani gara",
"noteHe": "אישה אומרת: אני גרה"
},
{
"id": "p:introductions:7",
"situation": "introductions",
"he": "בן כמה אתה?",
"heNiqqud": "בֶּן כַּמָּה אַתָּה?",
"translit": "ben kama ata?",
"en": "How old are you?",
"noteEn": "To a woman: bat kama at?"
},
{
"id": "p:introductions:8",
"situation": "introductions",
"he": "אני בן עשרים",
"heNiqqud": "אֲנִי בֶּן עֶשְׂרִים",
"translit": "ani ben esrim",
"en": "I'm twenty years old",
"noteEn": "A woman says: ani bat esrim"
},
{
"id": "p:introductions:9",
"situation": "introductions",
"he": "אני לומד עברית",
"heNiqqud": "אֲנִי לוֹמֵד עִבְרִית",
"translit": "ani lomed ivrit",
"en": "I'm learning Hebrew",
"noteEn": "A woman says: ani lomedet",
"noteHe": "אישה אומרת: אני לומדת"
},
{
"id": "p:introductions:10",
"situation": "introductions",
"he": "אני מדבר קצת עברית",
"heNiqqud": "אֲנִי מְדַבֵּר קְצָת עִבְרִית",
"translit": "ani medaber ktsat ivrit",
"en": "I speak a little Hebrew",
"noteEn": "A woman says: ani medaberet",
"noteHe": "אישה אומרת: אני מדברת"
},
{
"id": "p:introductions:11",
"situation": "introductions",
"he": "אתה מדבר אנגלית?",
"heNiqqud": "אַתָּה מְדַבֵּר אַנְגְּלִית?",
"translit": "ata medaber anglit?",
"en": "Do you speak English?",
"noteEn": "To a woman: at medaberet anglit?"
},
{
"id": "p:introductions:12",
"situation": "introductions",
"he": "מה אתה עושה?",
"heNiqqud": "מָה אַתָּה עוֹשֶׂה?",
"translit": "ma ata ose?",
"en": "What do you do?",
"noteEn": "To a woman: ma at osa?"
},
{
"id": "p:introductions:13",
"situation": "introductions",
"he": "אני סטודנט",
"heNiqqud": "אֲנִי סְטוּדֵנְט",
"translit": "ani student",
"en": "I'm a student",
"noteEn": "A woman says: ani studentit"
},
{
"id": "p:courtesy:1",
"situation": "courtesy",
"he": "תודה",
"heNiqqud": "תּוֹדָה",
"translit": "toda",
"en": "Thank you"
},
{
"id": "p:courtesy:2",
"situation": "courtesy",
"he": "תודה רבה",
"heNiqqud": "תּוֹדָה רַבָּה",
"translit": "toda raba",
"en": "Thank you very much"
},
{
"id": "p:courtesy:3",
"situation": "courtesy",
"he": "בבקשה",
"heNiqqud": "בְּבַקָּשָׁה",
"translit": "bevakasha",
"en": "Please / You're welcome"
},
{
"id": "p:courtesy:4",
"situation": "courtesy",
"he": "על לא דבר",
"heNiqqud": "עַל לֹא דְּבֵּר",
"translit": "al lo davar",
"en": "Don't mention it"
},
{
"id": "p:courtesy:5",
"situation": "courtesy",
"he": "סליחה",
"heNiqqud": "סְלִיחָה",
"translit": "slikha",
"en": "Excuse me / Sorry"
},
{
"id": "p:courtesy:6",
"situation": "courtesy",
"he": "אני מצטער",
"heNiqqud": "אֲנִי מִצְטַעֵר",
"translit": "ani mitsta'er",
"en": "I'm sorry",
"noteEn": "A woman says: ani mitsta'eret",
"noteHe": "אישה אומרת: אני מצטערת"
},
{
"id": "p:courtesy:7",
"situation": "courtesy",
"he": "אין בעיה",
"heNiqqud": "אֵין בְּעָיָה",
"translit": "ein be'aya",
"en": "No problem"
},
{
"id": "p:courtesy:8",
"situation": "courtesy",
"he": "בסדר",
"heNiqqud": "בְּסֵדֶר",
"translit": "beseder",
"en": "Okay"
},
{
"id": "p:courtesy:9",
"situation": "courtesy",
"he": "כן",
"heNiqqud": "כֵּן",
"translit": "ken",
"en": "Yes"
},
{
"id": "p:courtesy:10",
"situation": "courtesy",
"he": "לא",
"heNiqqud": "לֹא",
"translit": "lo",
"en": "No"
},
{
"id": "p:courtesy:11",
"situation": "courtesy",
"he": "אולי",
"heNiqqud": "אוּלַי",
"translit": "ulai",
"en": "Maybe"
},
{
"id": "p:courtesy:12",
"situation": "courtesy",
"he": "בטח",
"heNiqqud": "בֶּטַח",
"translit": "betakh",
"en": "Sure"
},
{
"id": "p:courtesy:13",
"situation": "courtesy",
"he": "רגע",
"heNiqqud": "רֶגַע",
"translit": "rega",
"en": "Just a moment"
},
{
"id": "p:courtesy:14",
"situation": "courtesy",
"he": "בהצלחה",
"heNiqqud": "בְּהַצְלָחָה",
"translit": "behatslakha",
"en": "Good luck"
},
{
"id": "p:courtesy:15",
"situation": "courtesy",
"he": "בתיאבון",
"heNiqqud": "בְּתֵיאָבוֹן",
"translit": "beteavon",
"en": "Enjoy your meal"
},
{
"id": "p:courtesy:16",
"situation": "courtesy",
"he": "לבריאות",
"heNiqqud": "לַבְּרִיאוּת",
"translit": "labriut",
"en": "Bless you / Cheers",
"noteEn": "Said after a sneeze and when raising a glass."
},
{
"id": "p:courtesy:17",
"situation": "courtesy",
"he": "מזל טוב",
"heNiqqud": "מַזָּל טוֹב",
"translit": "mazal tov",
"en": "Congratulations"
},
{
"id": "p:learning:1",
"situation": "learning",
"he": "אני לא מבין",
"heNiqqud": "אֲנִי לֹא מֵבִין",
"translit": "ani lo mevin",
"en": "I don't understand",
"noteEn": "A woman says: ani lo mevina",
"noteHe": "אישה אומרת: אני לא מבינה"
},
{
"id": "p:learning:2",
"situation": "learning",
"he": "אתה יכול לדבר לאט?",
"heNiqqud": "אַתָּה יָכוֹל לְדַבֵּר לְאַט?",
"translit": "ata yakhol ledaber le'at?",
"en": "Can you speak slowly?",
"noteEn": "To a woman: at yekhola…"
},
{
"id": "p:learning:3",
"situation": "learning",
"he": "אפשר לחזור על זה?",
"heNiqqud": "אֶפְשָׁר לַחֲזוֹר עַל זֶה?",
"translit": "efshar lakhzor al ze?",
"en": "Can you repeat that?"
},
{
"id": "p:learning:4",
"situation": "learning",
"he": "מה זה?",
"heNiqqud": "מָה זֶה?",
"translit": "ma ze?",
"en": "What is this?"
},
{
"id": "p:learning:5",
"situation": "learning",
"he": "מה זה אומר?",
"heNiqqud": "מָה זֶה אוֹמֵר?",
"translit": "ma ze omer?",
"en": "What does it mean?"
},
{
"id": "p:learning:6",
"situation": "learning",
"he": "איך אומרים את זה בעברית?",
"heNiqqud": "אֵיךְ אוֹמְרִים אֶת זֶה בְּעִבְרִית?",
"translit": "eikh omrim et ze be'ivrit?",
"en": "How do you say this in Hebrew?"
},
{
"id": "p:learning:7",
"situation": "learning",
"he": "איך כותבים את זה?",
"heNiqqud": "אֵיךְ כּוֹתְבִים אֶת זֶה?",
"translit": "eikh kotvim et ze?",
"en": "How do you write this?"
},
{
"id": "p:learning:8",
"situation": "learning",
"he": "אני לא יודע",
"heNiqqud": "אֲנִי לֹא יוֹדֵעַ",
"translit": "ani lo yode'a",
"en": "I don't know",
"noteEn": "A woman says: ani lo yoda'at",
"noteHe": "אישה אומרת: אני לא יודעת"
},
{
"id": "p:learning:9",
"situation": "learning",
"he": "הבנתי",
"heNiqqud": "הֵבַנְתִּי",
"translit": "hevanti",
"en": "I got it"
},
{
"id": "p:cafe:1",
"situation": "cafe",
"he": "אפשר תפריט?",
"heNiqqud": "אֶפְשָׁר תַּפְרִיט?",
"translit": "efshar tafrit?",
"en": "Can I have a menu?"
},
{
"id": "p:cafe:2",
"situation": "cafe",
"he": "אני רוצה קפה",
"heNiqqud": "אֲנִי רוֹצֶה קָפֶה",
"translit": "ani rotse kafe",
"en": "I want a coffee",
"noteEn": "A woman says: ani rotsa",
"noteHe": "אישה אומרת: אני רוצה (rotsa)"
},
{
"id": "p:cafe:3",
"situation": "cafe",
"he": "קפה הפוך, בבקשה",
"heNiqqud": "קָפֶה הָפוּךְ, בְּבַקָּשָׁה",
"translit": "kafe hafukh, bevakasha",
"en": "A latte, please",
"noteEn": "\"Hafukh\" (upside-down) is the Israeli latte."
},
{
"id": "p:cafe:4",
"situation": "cafe",
"he": "כוס מים, בבקשה",
"heNiqqud": "כּוֹס מַיִם, בְּבַקָּשָׁה",
"translit": "kos mayim, bevakasha",
"en": "A glass of water, please"
},
{
"id": "p:cafe:5",
"situation": "cafe",
"he": "מה אתה ממליץ?",
"heNiqqud": "מָה אַתָּה מַמְלִיץ?",
"translit": "ma ata mamlits?",
"en": "What do you recommend?",
"noteEn": "To a woman: ma at mamlitsa?"
},
{
"id": "p:cafe:6",
"situation": "cafe",
"he": "אני צמחוני",
"heNiqqud": "אֲנִי צִמְחוֹנִי",
"translit": "ani tsimkhoni",
"en": "I'm vegetarian",
"noteEn": "A woman says: ani tsimkhonit"
},
{
"id": "p:cafe:7",
"situation": "cafe",
"he": "בלי סוכר",
"heNiqqud": "בְּלִי סוּכָּר",
"translit": "bli sukar",
"en": "Without sugar"
},
{
"id": "p:cafe:8",
"situation": "cafe",
"he": "זה טעים מאוד",
"heNiqqud": "זֶה טָעִים מְאוֹד",
"translit": "ze ta'im me'od",
"en": "This is very tasty"
},
{
