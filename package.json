{
  "name": "linguaadapt",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "predeploy": "npx expo export -p web --output-dir dist && node -e \"require('fs').writeFileSync(require('path').join('dist','.nojekyll'),'')\"",
    "deploy:web": "npm run predeploy && gh-pages -d dist",
    "deploy:ios": "eas build --platform ios --profile production --non-interactive",
    "deploy:ios:preview": "eas build --platform ios --profile preview --non-interactive",
    "deploy:android": "eas build --platform android --profile production --non-interactive",
    "deploy:android:preview": "eas build --platform android --profile preview --non-interactive",
    "deploy:mobile": "eas build --platform all --profile production --non-interactive",
    "deploy:all": "npm run deploy:web && eas build --platform all --profile production --non-interactive",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "content:fetch": "sh scripts/content/fetch.sh",
    "content:setup-niqqud": "sh scripts/content/setup-niqqud.sh",
    "content:niqqud": "HF_HOME=.cache/hf HF_HUB_OFFLINE=1 .cache/venv/bin/python -I scripts/content/niqqud.py .cache/niqqud-todo.txt scripts/content/niqqud-cache.json",
    "content:build": "python3 -I scripts/content/build.py",
    "audio:count": "tsx scripts/audio/generate.ts --dry-run",
    "audio:generate": "tsx scripts/audio/generate.ts",
    "audio:setup-local": "sh scripts/audio/setup-local.sh",
    "audio:manifest": "tsx scripts/audio/generate.ts --manifest"
  },
  "homepage": "https://BARDAMRI.github.io/LinguaAdapt",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@supabase/supabase-js": "^2.105.3",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.9",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "i18n-js": "^4.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "gh-pages": "^6.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  }
}
